{
  "manifest_version": 3,
  "name": "Plainview",
  "version": "1.2.4",
  "description": "Read Markdown, JSON, XML, YAML, TOML, CSV and logs locally with search, trees, tables and clean exports.",
  "permissions": ["storage", "clipboardWrite"],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["boot.js"],
      "css": ["styles.css"],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": ["file:///*.xml", "http://*/*.xml", "https://*/*.xml"],
      "css": ["xml-loading.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["app.js"],
      "matches": ["http://*/*", "https://*/*", "file:///*"]
    }
  ],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Plainview settings",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  }
}
