{
  "manifest_version": 3,
  "name": "Plainview",
  "version": "0.3.0",
  "description": "Render Markdown, JSON and XML files opened in Chrome or Firefox. Includes Mermaid diagrams and content zoom.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "downloads"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "vendor/marked.umd.js",
        "vendor/viewer-css.js",
        "src/core/settings.js",
        "src/core/dom.js",
        "src/core/scroll-utils.js",
        "src/core/clipboard.js",
        "src/core/download.js",
        "src/core/fonts.js",
        "src/formats/shared/error-panel.js",
        "src/core/formats.js",
        "src/core/document.js",
        "src/formats/markdown/core.js",
        "src/formats/markdown/enhance.js",
        "src/formats/markdown/title-block.js",
        "src/formats/source/core.js",
        "src/formats/source/markdown.js",
        "src/formats/source/json.js",
        "src/formats/source/xml.js",
        "src/formats/json/parse.js",
        "src/formats/shared/data-toolbar.js",
        "src/formats/json/view.js",
        "src/formats/xml/parse.js",
        "src/formats/xml/render.js",
        "src/formats/xml/view.js",
        "src/formats/mermaid/svg-sanitize.js",
        "src/formats/mermaid/loader.js",
        "src/app/topbar.js",
        "src/app/scroll-spy.js",
        "src/app/toc.js",
        "src/app/zoom.js",
        "src/app/theme.js",
        "src/app/view-switcher.js",
        "src/core/scroll-memory.js",
        "src/app/ui.js",
        "src/app/content.js"
      ],
      "css": [
        "src/styles/tokens.css",
        "src/styles/topbar.css",
        "src/styles/layout.css",
        "src/styles/data.css",
        "src/styles/trees.css",
        "src/styles/mermaid.css",
        "src/styles/responsive.css",
        "src/styles/source.css",
        "src/styles/theme-html.css",
        "src/styles/theme-html-doc.css"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/mermaid/mermaid.esm.min.mjs"
      ],
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ]
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Plainview settings",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  }
}
