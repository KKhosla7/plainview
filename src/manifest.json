{
  "manifest_version": 3,
  "name": "Plainview",
  "version": "1.2.0",
  "description": "Render Markdown, JSON, XML, YAML, TOML and CSV files in Chrome or Firefox. Includes Mermaid, code highlighting, math, JSONPath, JMESPath, XPath, CSV sort/filter and standalone HTML export.",
  "permissions": ["storage", "clipboardWrite", "downloads"],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["boot.js"],
      "css": ["styles.css"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["app.js"],
      "matches": ["http://*/*", "https://*/*", "file:///*"]
    }
  ],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Plainview settings",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  }
}
