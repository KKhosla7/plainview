{
  "name": "plainview",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Browser extension that renders Markdown, JSON and XML files opened in Chrome or Firefox",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node scripts/test.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "package": "npm run build && node scripts/package.mjs",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "marked": "^18.2.0",
    "mermaid": "^11.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "1.64.1",
    "esbuild": "^0.28.2",
    "web-ext": "^10.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kk18888678/plainview.git"
  },
  "homepage": "https://github.com/kk18888678/plainview#readme",
  "bugs": {
    "url": "https://github.com/kk18888678/plainview/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "kk18888678",
  "license": "MIT"
}
